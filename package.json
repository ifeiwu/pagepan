{
  "name": "pagepan",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "dev": "concurrently -k \"npm:dev:css\" \"npm:dev:js\"",
    "dev:css": "npx @tailwindcss/cli -i ./assets/admin/css/sp-ui.css -o ./src/public/assets/admin/css/sp-ui.css --watch",
    "dev:js": "esbuild ./assets/admin/js/*.js --bundle --outdir=./src/public/assets/admin/js --format=iife --target=es2020 --watch",
    "build": "npm run build:css && npm run build:js",
    "build:css": "npx @tailwindcss/cli -i ./assets/admin/css/sp-ui.css -o ./src/public/assets/admin/css/sp-ui.css --minify",
    "build:js": "esbuild ./assets/admin/js/*.js --bundle --minify --outdir=./src/public/assets/admin/js --format=iife --target=es2020"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ifeiwu/pagepan.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/ifeiwu/pagepan/issues"
  },
  "homepage": "https://github.com/ifeiwu/pagepan#readme",
  "dependencies": {
    "@tailwindcss/cli": "^4.3.3",
    "@zumer/snapdom": "^3.7.4",
    "interactjs": "^1.10.28",
    "pubsub-js": "^1.9.5",
    "starting-point-ui": "^0.39.0",
    "tailwindcss": "^4.3.3",
    "winbox": "^0.2.82"
  },
  "devDependencies": {
    "concurrently": "^10.0.7",
    "esbuild": "^0.28.2"
  }
}
