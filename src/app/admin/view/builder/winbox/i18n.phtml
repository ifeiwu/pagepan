                        <input name="<?=$lang?>" value="<?=html_encode($i18n_list[$lang]) ?: html_encode($get_text)?>" class="uk-input texts" type="text">

                    </div>
                </div>
            </div>
            <?php endforeach; ?>
        </form>
    </div>
    
    <script>
        require([], function() {
            // 自动翻译
            $('.auto-translate').click(function(e) {
                let $this = $(this);
                let $input = $this.siblings('input');
                let data = $this.data();
                data.text = $input.val();
                data.driver = 'baidu';
                
                $.post('site/langs/translate', data, function (text) {
                    if (text) {
                        $input.val(text);
                    } else {
                        alert('自动翻译失败！');
                    }
                });
            });

            // 清空内容
            $('.empty-content').click(function(e) {
                let $this = $(this);
                let $input = $this.siblings('input');
                $input.val('');
            });
        
            // 父窗口获取值
            window.getValue = function() {
                let is_save = false;
                let data_lang = $('#data_lang').val();
                let i18n_list = $('input.texts').serializeArray();
                // 如果 i18n_key 等于 i18n_key2 表示没有修改键，相反不等于需要删除之前的键 i18n_key2
                let i18n_key = $('#i18n_key').val();
                let i18n_key2 = $('#i18n_key').data('value');

                $.ajax({
                    method: 'POST',
                    url: 'site/langs/save-kv',
                    async: false,
                    dataType: 'json',
                    data: {'i18n_key': i18n_key, 'i18n_key2': i18n_key2, 'i18n_list': i18n_list},
                    success: function (res) {
                        if (res.code == 1) {
                            alert(res.message);
                        } else {
                            is_save = true;
                        }
                    }
                });
                return is_save == true ? {'data_lang': data_lang, 'i18n_key': i18n_key} : {};
            };
            
            // 父窗口设置值
            window.setValue = function(value) {
            };
            
            window.parent.postMessage({loaded: true}, '*');
        });
    </script>

</body>
</html>