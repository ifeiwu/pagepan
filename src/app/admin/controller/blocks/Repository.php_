<?php

namespace app\admin\controller\blocks;

use app\exception\DatastarAlertException;
use CzProject\GitPhp\Git;
use support\Db;
use support\FileSystem;
use support\Request;

class Repository
{
    public function list(Request $request): void
    {
        $ds = datastar();
        $db = db();

        $repos = $db->table('git_repo')->orderByDesc('id')->get()->toArray();
        $html = '';
        foreach ($repos as $repo) {
            $html .= '<option value="' . $repo->id . '">' . $repo->path . '</option>';
        }
        $ds->inner($html, '#repo_options');
        $ds->signals(['repo_id' => $repos[0]->id]);
        $ds->event('change', [], '[name="repo_id"]');

        $ds->close();
    }

    // 添加仓库
    public function add(Request $request): void
    {
        $url = $request->post('url');
        $path = trim(parse_url($url, PHP_URL_PATH), '/');
        $path = preg_replace('/\.git$/', '', $path);
        $save_path = storage_path("repository/$path");

        try {
            $git = new Git;

            if (!is_dir($save_path . '/.git')) {
                // 首次克隆
                $git->cloneRepository($url, $save_path);
            } else {
                // 已存在，拉取更新
                $repo = $git->open($save_path);
                $repo->pull('origin');
            }
        } catch (\Throwable $e) {
            throw new DatastarAlertException($e->getMessage());
        }

        Db::beginTransaction();

        try {
            $db = db();

            // 添加仓库
            $repo_id = $db->table('git_repo')->where(['path' => $path])->value('id');
            if (!$repo_id) {
                $repo_id = $db->table('git_repo')->insertGetId([
                    'path' => $path,
                    'url' => $url,
                    'created' => date('Y-m-d H:i:s'),
                ]);
            }

            // 获取内容块列表
            $blocks = $this->buildRepoBlocks($save_path, $repo_id);

            // 保存仓库内容块
            $db->table('git_block')->where('repo_id', $repo_id)->delete();
            $db->table('git_block')->insert($blocks);

            Db::commit();

            $ds = datastar();
            $ds->event('reload', [], 'select[name="repo_id"]');
            $ds->script('AddModal.close()');
            $ds->close();
        } catch (\Throwable $ex) {
            Db::rollBack();
            throw new DatastarAlertException($ex->getMessage());
        }
    }

    // 构建仓库目录内容块列表
    private function buildRepoBlocks($basePath, $repo_id): array
    {
        $list = [];

        foreach (glob($basePath . '/*/*/info.php') as $file) {
            $category = basename(dirname($file, 2));

            if ($category === 'components') {
                continue;
            }

            $info = require $file;
            if (!is_array($info)) {
                continue;
            }

            $info['category'] = $category;
            $info['dirname'] = basename(dirname($file));
            $info['repo_id'] = $repo_id;
            $list[] = $info;
        }

        return $list;
    }

    public function delete(Request $request): void {
        $ds = datastar();
        $repo_id = $ds->getSignals('repo_id');

        Db::beginTransaction();
        try {
            $db = db();

            $repo_path = $db->table('git_repo')->where(['id' => $repo_id])->value('path');
            if ($db->table('git_repo')->where('id', $repo_id)->delete()) {
                $code = 1;
                $base_path = realpath(storage_path('repository'));
                $full_path = realpath(storage_path("repository/$repo_path"));

                if ($base_path &&
                    $full_path &&
                    str_starts_with($full_path, $base_path . DIRECTORY_SEPARATOR) &&
                    is_dir($full_path . DIRECTORY_SEPARATOR . '.git')
                ) {
                    if (PHP_OS_FAMILY === 'Windows') {
                        exec('rmdir /s /q ' . escapeshellarg($full_path), $output, $code);
                    } else {
                        exec('rm -rf -- ' . escapeshellarg($full_path), $output, $code);
                    }
                }

                if ($code !== 0) {
                    Db::rollBack();
                    throw new DatastarAlertException("删除目录失败");
                }

                Db::commit();

                $ds->event('reload', [], 'select[name="repo_id"]');
                $ds->close();
            } else {
                throw new DatastarAlertException("删除失败");
            }
        } catch (\Throwable $ex) {
            Db::rollBack();
            throw new DatastarAlertException($ex->getMessage());
        }
    }



