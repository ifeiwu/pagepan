    <script>
        (() => {
            const section = document.currentScript.closest('section');
            const billingSwitch = section.querySelector('#billing-switch');
            const priceElements = section.querySelectorAll('.plan-price');
            const billingPeriod = section.querySelectorAll('.plan-price + span');

            billingSwitch.addEventListener('click', () => {
                const isYearly = billingSwitch.getAttribute('aria-checked') !== 'true';

                billingSwitch.setAttribute('aria-checked', String(isYearly));

                const thumb = billingSwitch.firstElementChild;

                billingSwitch.classList.toggle('bg-primary', isYearly);
                billingSwitch.classList.toggle('bg-input', !isYearly);
                thumb.classList.toggle('translate-x-3', isYearly);
                thumb.classList.toggle('translate-x-0', !isYearly);

                priceElements.forEach((price) => {
                    const value = isYearly ? price.dataset.yearly : price.dataset.monthly;
                    price.textContent = `$${value}`;
                });

                billingPeriod.forEach((period) => {
                    period.textContent = isYearly ? '/年' : '/月';
                });
            });
        })();
    </script>
